{
  "name": "pianochart-dsh",
  "version": "0.2.3",
  "description": "Turn one audio link into a playable piano score: staff, numbered notation, MusicXML, MIDI. One arrangement in three keys.",
  "type": "module",
  "license": "MIT",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "lib",
    "skill",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "piano",
    "sheet-music",
    "musicxml",
    "jianpu",
    "mcp"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/regrevia/everything2chart.git",
    "directory": "dsh-bundle"
  },
  "homepage": "https://github.com/regrevia/everything2chart/tree/main/dsh-bundle#readme",
  "bugs": {
    "url": "https://github.com/regrevia/everything2chart/issues"
  },
  "author": {
    "name": "regrevia",
    "url": "https://github.com/regrevia"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-mcp-client": ">=0.1.0-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0"
  }
}
